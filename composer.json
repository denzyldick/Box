{
  "name": "denzyl/box",
  "description": "A type-safe Result type for explicit error handling in PHP.",
  "type": "library",
  "keywords": [
    "result",
    "error-handling",
    "functional",
    "exceptions"
  ],
  "homepage": "https://github.com/denzyldick/box",
  "support": {
    "issues": "https://github.com/denzyldick/box/issues",
    "source": "https://github.com/denzyldick/box"
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "format": "./mago format",
    "format:check": "./mago format --check",
    "lint": "./mago lint --minimum-fail-level error --minimum-report-level error",
    "phanalist": "${PHANALIST_BIN:-phanalist} -c phanalist.yaml -s src",
    "test": "vendor/bin/phpunit",
    "composer:validate": "composer validate --strict",
    "ci": [
      "@composer:validate",
      "@format:check",
      "@lint",
      "@phanalist",
      "@test"
    ]
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Result\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Dummy\\": "tests/dummy/"
    }
  },
  "authors": [
    {
      "name": "Denzyl Dick"
    }
  ]
}
